{
  "DashboardPort": 5000,
  "EnableRemoteDashboard": true,
  "DashboardBindAddress": "0.0.0.0",
  "KillDelaySeconds": 30,
  "ShowWarningOnChildPc": true,
  "PollIntervalMs": 1000,
  "FlushIntervalSec": 30,
  "HotKeyModifiers": "Control+Alt",
  "HotKeyKey": "H",
  "KnownApps": {
    "FortniteClient-Win64-Shipping.exe": "Fortnite",
    "FortniteClient-Win64-Shipping_EAC.exe": "Fortnite",
    "FortniteLauncher.exe": "Fortnite",
    "RobloxPlayerBeta.exe": "Roblox",
    "RobloxStudioBeta.exe": "Roblox Studio",
    "Minecraft.Windows.exe": "Minecraft",
    "MinecraftLauncher.exe": "Minecraft",
    "Discord.exe": "Discord",
    "Steam.exe": "Steam",
    "chrome.exe": "Chrome",
    "msedge.exe": "Edge",
    "firefox.exe": "Firefox"
  },
  "DefaultLimits": [
    { "AppName": "Fortnite", "DailyMaxMinutes": 120 },
    { "AppName": "Roblox", "DailyMaxMinutes": 90 },
    { "AppName": "Minecraft", "DailyMaxMinutes": 120 }
  ],
  "Schedule": [
    { "DayOfWeek": "Weekday", "StartTime": "02:00", "EndTime": "21:00" },
    { "DayOfWeek": "Weekend", "StartTime": "05:00", "EndTime": "22:00" }
  ]
}
